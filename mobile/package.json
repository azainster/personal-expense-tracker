{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "ios": "expo run:ios",
    "ios:prebuild": "expo prebuild --platform ios --clean && sh scripts/ios-xcode-env.sh",
    "ios:open": "xed ios",
    "ios:device": "expo run:ios --device",
    "ios:device:release": "expo run:ios --device --configuration Release",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "vitest run",
    "doctor": "expo-doctor",
    "verify:bundle": "expo export --platform ios --output-dir dist --clear",
    "verify:native": "expo prebuild --platform ios --no-install --clean",
    "build:ios:dev": "eas build --platform ios --profile development",
    "build:ios:preview": "eas build --platform ios --profile preview",
    "build:ios": "eas build --platform ios --profile production",
    "submit:ios": "eas submit --platform ios --profile production --latest",
    "eas-build-post-install": "npm run build -w @expense/core"
  },
  "dependencies": {
    "@expense/core": "1.0.0",
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.22",
    "expo-application": "~57.0.3",
    "expo-auth-session": "~57.0.12",
    "expo-background-task": "~57.0.17",
    "expo-build-properties": "~57.0.17",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.10",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.17",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "typescript": "~6.0.3",
    "vitest": "^3.0.5"
  }
}
