# ─────────────────────────────────────────────────────────────────────────────
# Server configuration (server/)
#
# Copy to .env (git-ignored) and fill in what you need. The iPhone app has its own
# build-time settings in mobile/.env.example — nothing in this file goes into the app.
#
# The server does two different jobs:
#   1. /api/v1/*  — the small public API the iPhone app uses: the rules pack, and the
#                   optional AI fallback proxy. Stateless. This is what you deploy.
#   2. /api/auth, /api/transactions, /api/sync, … — a single-user development dashboard
#                   (web/) that reads Gmail on your Mac. Local development only.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
PORT=4000
# 0.0.0.0 lets an iPhone on the same Wi-Fi reach /api/v1 at http://<your-mac-ip>:4000.
# The development dashboard routes still only answer requests from this computer.
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
# Honour X-Forwarded-For behind a hosting proxy. Defaults to true when NODE_ENV=production.
TRUST_PROXY=

# ── Development dashboard (local only) ───────────────────────────────────────
# Defaults to true in development and false in production.
ENABLE_DEV_API=
# Leave false. When true, dashboard routes (your financial data) answer other devices too.
ALLOW_REMOTE_DEV_API=false
WEB_ORIGIN=http://localhost:5173
PUBLIC_URL=http://localhost:4000
DATABASE_PATH=./data/expenses.db

# Gmail for the *dashboard* uses a Google OAuth client of type "Web application".
# This localhost callback is for local development ONLY — the iPhone app does not use it.
# The iPhone app uses its own "iOS" OAuth client with a custom-scheme redirect and no
# secret (see SETUP.md, "Google Cloud").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
# AES-256-GCM key for the dashboard's stored refresh token. Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
SYNC_WINDOW_DAYS=35
SYNC_INTERVAL_MINUTES=0
SYNC_MAX_MESSAGES_PER_RUN=400
DISCOVERY_SWEEP_HOURS=168
DEFAULT_CURRENCY=INR
LOCALE_HINT=en-IN
# The dashboard's own sync loop uses the AI fallback only when this is true.
ENABLE_REMOTE_LLM_FALLBACK=false

# ── AI fallback (L4) — shared by the app proxy and the dashboard ─────────────
# Server-side only. Never put this key in the iPhone app or in mobile/.env.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5
LLM_MAX_CALLS_PER_SYNC=25

# Proxy for the iPhone app (/api/v1/llm/*). Off until you enable it here AND set the key.
LLM_PROXY_ENABLED=false
# Optional. If set, the app must send the same value (EXPO_PUBLIC_API_APP_TOKEN). It ships
# inside the app, so treat it as an abuse deterrent, not a secret.
LLM_PROXY_SHARED_TOKEN=
# Per-IP request cap for the proxy.
LLM_PROXY_RATE_PER_HOUR=120

# ── Rules pack ───────────────────────────────────────────────────────────────
# Defaults to packages/core/rules/rules-pack.json. Point elsewhere to serve a different pack.
# RULES_PACK_PATH=
