{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "sourceMap": true,
    // No Node types in the shipped build: anything that reaches for Buffer, process or
    // node:* fails to compile here, because this code also runs on the iPhone (Hermes).
    "types": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/__tests__/**", "src/tools/**"]
}
